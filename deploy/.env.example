# Copy to deploy/.env on the server (never committed: deploy/.gitignore) and replace every <...>.
# Passwords: letters and digits only (e.g. `openssl rand -hex 24`), so the URLs below need no encoding.

# --- Images (docker compose pull) ---------------------------------------------------------------
# Pushed by .github/workflows/cd.yml. `latest` follows master; `sha-<full commit sha>` pins one version
# (rollback: deploy/README.md).
WEB_IMAGE=ghcr.io/g3wis/ucicle-web
JOBS_IMAGE=ghcr.io/g3wis/ucicle-jobs
IMAGE_TAG=latest

# --- PostgreSQL (service db) --------------------------------------------------------------------
# Owner role: creates the tables (yarn migrate) and runs the jobs.
POSTGRES_USER=ucicle
POSTGRES_DB=ucicle
POSTGRES_PASSWORD=<owner-password>
# Read-only role `ucicle_web` of the website, created by db/init/01-roles.sql.
POSTGRES_WEB_PASSWORD=<web-password>

# --- Website (service web) ----------------------------------------------------------------------
# Read-only role. Same password as POSTGRES_WEB_PASSWORD.
WEB_DATABASE_URL=postgres://ucicle_web:<web-password>@db:5432/ucicle
# Size of the website's connection pool.
DATABASE_POOL=5
# Where the game's riders.json / secret_rider.json are read (the Scaleway function writes them to
# the bucket). Must be https://.
GAME_DATA_ORIGIN=https://s3.fr-par.scw.cloud/ucicle.com
# GAME_DATA_DIR (read the two files from a directory instead) is not wired: it would also need a
# volume mounted into `web` in docker-compose.yml.

# --- Jobs (service jobs) ------------------------------------------------------------------------
# Owner role. Same password as POSTGRES_PASSWORD.
JOBS_DATABASE_URL=postgres://ucicle:<owner-password>@db:5432/ucicle
# Wall clock of the schedule.
TZ=Europe/Paris
# Nightly sequence: collect --recent COLLECT_RECENT_DAYS, enrich:wikidata on WEEKLY_DAY, rate.
NIGHTLY_AT=04:00
# 1 = Monday ... 7 = Sunday.
WEEKLY_DAY=7
COLLECT_RECENT_DAYS=14
# Optional: User-Agent sent to UCI DataRide and Wikidata (empty = the code's default).
HTTP_USER_AGENT=

# --- nginx (service nginx) ----------------------------------------------------------------------
# Host directory of the Let's Encrypt files (live/www.ucicle.fr/ must exist before nginx starts).
TLS_CERTS_DIR=/etc/letsencrypt
# Host directory served on /.well-known/acme-challenge/ (certbot --webroot -w <this directory>).
ACME_WEBROOT=/var/www/certbot
