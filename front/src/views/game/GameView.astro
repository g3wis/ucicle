---
/**
 * The daily game: a client-only React island. Today's JSON files are requested by an inline
 * script in the head, in parallel with the bundle (src/data/api.ts fetchToday). The static
 * fallback carries the page's H1 (for the HTML as served) and, without JavaScript, says so and
 * offers the pages that work without it.
 */
import Base from '../../layouts/Base.astro';
import GameIsland from '../../app/GameIsland';
import { meta } from '../../content/meta';
import { common } from '../../content/common';
import { absolute, PAGES } from '../../app/nav';
import type { Lang } from '../../i18n/language';

interface Props { lang: Lang }
const { lang } = Astro.props;
const m = meta[lang].game;
const c = common[lang];
const jsonLd = [{
  '@type': 'Game',
  name: 'Ucicle',
  url: absolute(PAGES.game[lang]),
  inLanguage: lang,
  description: m.description,
  isPartOf: { '@id': absolute('/#website') },
}];
---
<Base lang={lang} page="game" title={m.title} description={m.description} ogTitle={m.ogTitle} path={PAGES.game[lang]} alternates={PAGES.game} jsonLd={jsonLd}>
  <script is:inline slot="head">
    window.ucicleData = Promise.all(['/api/riders.json', '/api/secret_rider.json'].map(function (u) {
      return fetch(u, { cache: 'no-cache' }).then(function (r) {
        if (!r.ok) throw new Error(u + ' answered ' + r.status);
        return r.json();
      });
    }));
    window.ucicleData.catch(function () {});
  </script>
  <GameIsland client:only="react" lang={lang}>
    <main id="main" class="game game-wait" slot="fallback">
      <h1 class="sr-only">{c.game.title}</h1>
      <p class="game-status">{c.game.loading}</p>
      <noscript>
        <p>{c.game.noScript}</p>
        <p><a class="text-link" href={PAGES.ranking[lang]}>{c.nav.ranking}</a> <a class="text-link" href={PAGES.about[lang]}>{c.footer.about}</a></p>
      </noscript>
    </main>
  </GameIsland>
</Base>
