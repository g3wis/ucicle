{
  "name": "ucicle",
  "version": "0.0.0",
  "main": "build/main/index.js",
  "author": "Guillaume Houis <guillaume.houis@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ci": "yarn && yarn lint && yarn build",
    "cd": "yarn && yarn build && node deploy.js",
    "build": "tsc -p tsconfig.json",
    "load:local": "node build/local.js",
    "migrate": "node build/cli/migrate.js",
    "collect": "node build/cli/collect.js",
    "rate": "node --max-old-space-size=8192 build/cli/rate.js",
    "calibrate": "node --max-old-space-size=8192 build/cli/calibrate.js",
    "check:rating": "node build/rating/check.js",
    "enrich:wikidata": "node build/cli/enrich.js",
    "lint": "eslint src",
    "fix:lint": "eslint src --fix",
    "watch:build": "tsc -p tsconfig.json -w",
    "doc": "typedoc --options typedoc.json"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.363.0",
    "axios": "^1.4.0",
    "dayjs": "^1.11.9",
    "dotenv": "^16.3.1",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "adm-zip": "^0.5.10",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "mime": "^3.0.0",
    "ts-node": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.json",
    "../../../../Downloads/ucicle/ucicle/LICENSE",
    "../../README.md"
  ]
}
